  m_Script: {fileID: 11500000, guid: 3a4d015e6f05c93180eeceb351e805bb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  player: {fileID: 10026}
  stages:
  - title: 'Bloom: flower and vine'
    hint: BLOOM the flower; stand on it and Space. BLOOM the vine; E near its handle;
      Space to release forward.
    spawn: {fileID: 10101}
    nodes:
    - {fileID: 10226}
    - {fileID: 10266}
    goalRequirements:
    - {fileID: 10226}
    - {fileID: 10266}
  - title: 'Freeze: falling stone and slate'
    hint: FREEZE the falling stone near the low blue mark; jump to the ledge. Freeze
      the slate near 0 degrees.
    spawn: {fileID: 10421}
    nodes:
    - {fileID: 10546}
    - {fileID: 10606}
    goalRequirements:
    - {fileID: 10606}
  - title: 'Pulse + Freeze: machine bridge'
    hint: PULSE the machine to rotate it. FREEZE near 0 degrees, then cross the cyan
      bridge.
    spawn: {fileID: 10721}
    nodes:
    - {fileID: 10826}
    goalRequirements:
    - {fileID: 10826}
  - title: 'Pulse + Freeze: ice ski jump'
    hint: PULSE the sluice, FREEZE the water, then E beside the leaf. Steer with
      A/D; launch at the ramp end.
    spawn: {fileID: 10901}
    nodes:
    - {fileID: 11006}
    - {fileID: 11026}
    goalRequirements:
    - {fileID: 11026}
  - title: 'Bloom + Pulse: living conductor'
    hint: BLOOM the root bridge. PULSE the source. Power must travel through the
      grown root to open the far door.
    spawn: {fileID: 11161}
    nodes:
    - {fileID: 11266}
    - {fileID: 11286}
    - {fileID: 11326}
    goalRequirements:
    - {fileID: 11286}
    - {fileID: 11326}
  - title: 'The spring: three abilities together'
    hint: BLOOM the roots, PULSE the source, FREEZE the powered rotor at 0 degrees.
      Cross and PULSE the central core.
    spawn: {fileID: 11401}
    nodes:
    - {fileID: 11526}
    - {fileID: 11546}
    - {fileID: 11586}
    - {fileID: 11606}
    goalRequirements:
    - {fileID: 11546}
    - {fileID: 11586}
    - {fileID: 11606}
  debugStageSelection: 1
  startStage: 0
