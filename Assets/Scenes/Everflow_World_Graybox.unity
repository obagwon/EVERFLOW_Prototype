  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EverflowGraybox.EFWorld
  player: {fileID: 729046792}
  stages:
  - title: 'Bloom: flower and vine'
    hint: BLOOM the flower; stand on it and Space. BLOOM the vine; E near its handle;
      Space to release forward.
    spawn: {fileID: 134868966}
    nodes:
    - {fileID: 64071659}
    - {fileID: 1915819104}
    goalRequirements:
    - {fileID: 64071659}
    - {fileID: 1915819104}
  - title: 'Freeze: falling stone and slate'
    hint: FREEZE the falling stone near the low blue mark; jump to the ledge. Freeze
      the slate near 0 degrees.
    spawn: {fileID: 1755332482}
    nodes:
    - {fileID: 1620132783}
    - {fileID: 1819579220}
    goalRequirements:
    - {fileID: 1620132783}
    - {fileID: 1819579220}
  - title: 'Pulse + Freeze: machine bridge'
    hint: PULSE the machine to rotate it. FREEZE near 0 degrees, then cross the cyan
      bridge.
    spawn: {fileID: 696355957}
    nodes:
    - {fileID: 699975614}
    goalRequirements:
    - {fileID: 699975614}
  - title: 'Pulse + Freeze: ice ski jump'
    hint: PULSE the sluice, FREEZE the water, then E beside the leaf. Steer with
      A/D; launch at the ramp end.
    spawn: {fileID: 278348092}
    nodes:
    - {fileID: 771115176}
    - {fileID: 1385623817}
    goalRequirements:
    - {fileID: 1385623817}
  - title: 'Bloom + Pulse: living conductor'
    hint: BLOOM the root bridge. PULSE the source. Power must travel through the
      grown root to open the far door.
    spawn: {fileID: 367965413}
    nodes:
    - {fileID: 1420760297}
    - {fileID: 1776805042}
    - {fileID: 1796349606}
    goalRequirements:
    - {fileID: 1776805042}
    - {fileID: 1796349606}
  - title: 'The spring: three abilities together'
    hint: BLOOM the roots, PULSE the source, FREEZE the powered rotor at 0 degrees.
      Cross and PULSE the central core.
    spawn: {fileID: 1125142036}
    nodes:
    - {fileID: 43259848}
    - {fileID: 791249231}
    - {fileID: 142479065}
    - {fileID: 1231951918}
    goalRequirements:
    - {fileID: 791249231}
    - {fileID: 142479065}
    - {fileID: 1231951918}
  debugStageSelection: 0
  initialSpawn: {fileID: 2025742440}
