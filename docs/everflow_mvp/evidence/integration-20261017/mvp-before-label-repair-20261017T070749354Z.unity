  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EverflowMap.EFMapWorld
  player: {fileID: 1724823459}
  stages:
  - hint: 'P1: BLOOM flower; jump onto its dome, Space to launch. BLOOM the vine
      bud; approach the handle (jump + E if below it), Space to cross east.'
    spawn: {fileID: 2009678487}
    arrival: {fileID: 46391227}
    arrivalSize: {x: 6, y: 5, z: 7}
    nodes:
    - {fileID: 208149356}
    - {fileID: 514513843}
    requirements:
    - {fileID: 208149356}
    - {fileID: 514513843}
    restoration:
    - {fileID: 467406927}
  - hint: 'P2: Approach and FREEZE each falling debris at its blue height mark; jump
      onto it before aiming at the next. FREEZE the slate level. FREEZE again releases;
      no count limit.'
    spawn: {fileID: 191877655}
    arrival: {fileID: 2052792845}
    arrivalSize: {x: 6, y: 5, z: 7}
    nodes:
    - {fileID: 1256644189}
    - {fileID: 1043849065}
    - {fileID: 1965001225}
    - {fileID: 2069863036}
    requirements:
    - {fileID: 1965001225}
    - {fileID: 2069863036}
    - {fileID: 1043849065}
    - {fileID: 1256644189}
    restoration:
    - {fileID: 1753378530}
  - hint: 'P3: PULSE the crystal. Approach the bridge entrance and aim at the NEAR
      deck; FREEZE along east-west, then cross west to the ridge.'
    spawn: {fileID: 886395293}
    arrival: {fileID: 1230967736}
    arrivalSize: {x: 6, y: 5, z: 7}
    nodes:
    - {fileID: 628482714}
    - {fileID: 567929988}
    requirements:
    - {fileID: 567929988}
    - {fileID: 628482714}
    restoration: []
  - hint: 'Canal experiment (map P4): observe the raised exit and gap. PULSE the
      low courtyard pump, follow its pipe, FREEZE the water. Use the short side stairs;
      E beside the leaf. Walk to the far deck marker. Falling preserves prepared
      water/ice; R intentionally resets this puzzle.'
    spawn: {fileID: 969005412}
    arrival: {fileID: 2067115162}
    arrivalSize: {x: 8, y: 2.1, z: 2}
    nodes:
    - {fileID: 251074357}
    - {fileID: 1803132408}
    - {fileID: 409453996}
    requirements:
    - {fileID: 251074357}
    - {fileID: 1803132408}
    - {fileID: 409453996}
    restoration:
    - {fileID: 1418052637}
    - {fileID: 1474169520}
  - hint: 'P5: BLOOM the root beside the door. After the wire finishes growing, PULSE
      that same root; go through the door.'
    spawn: {fileID: 1804782765}
    arrival: {fileID: 1454693200}
    arrivalSize: {x: 4, y: 6, z: 6}
    nodes:
    - {fileID: 966481767}
    - {fileID: 970982633}
    requirements:
    - {fileID: 966481767}
    - {fileID: 970982633}
    restoration:
    - {fileID: 1449757149}
  - hint: 'P6: BLOOM entry roots. Cross to maintenance and PULSE. FREEZE the last
      channel, walk across, then PULSE the FINAL CONTROL. Arrival never starts the
      ending.'
    spawn: {fileID: 228827790}
    arrival: {fileID: 1299062452}
    arrivalSize: {x: 6, y: 5, z: 7}
